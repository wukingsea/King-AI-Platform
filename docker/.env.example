# docker-compose env template
# Usage: cp .env.example .env, then replace every CHANGE_ME value. Never commit .env.

# king-ai, api
KING_AI_API_PORT=8080

# king-ai, sample
KING_AI_SAMPLE_PORT=8091

# king-ai, database
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PATH=./data/mysql

# king-ai, redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PATH=./data/redis

# king-ai, milvus
MILVUS_PATH=./data/milvus
